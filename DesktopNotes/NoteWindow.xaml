<Window x:Class="DesktopNotes.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="桌面便签" Width="340" Height="360" MinWidth="280" MinHeight="240"
        Icon="/DesktopNotes;component/Assets/Note.ico" ShowInTaskbar="True"
        WindowStyle="None" ResizeMode="CanResize" Background="#FFF4C2"
        FontFamily="Microsoft YaHei UI" Foreground="#423D2C"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="Frame" BorderBrush="#DFD19D" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <Border x:Name="Header" Background="#F8E8A8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="10,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="●" FontSize="9" Foreground="#B59A42" VerticalAlignment="Center" Margin="3,0,9,0"/>
            <TextBlock Text="随手记" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolButton}" Content="+" ToolTip="新建便签 (Ctrl+N)" AutomationProperties.Name="新建便签" Click="New_Click"/>
            <Button x:Name="ChecklistButton" Style="{StaticResource ToolButton}" Focusable="False"
                    ToolTip="给当前行或选中行添加 / 移除勾选框 (Ctrl+Shift+C)" AutomationProperties.Name="添加或移除行勾选框" Click="Checklist_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73A;" FontSize="14"/>
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource ToolButton}" ToolTip="置顶" AutomationProperties.Name="置顶" Click="Pin_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="14"/>
            </Button>
            <Button x:Name="MoreButton" Style="{StaticResource ToolButton}" Content="···" ToolTip="颜色和更多选项" AutomationProperties.Name="更多选项" Click="More_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="—" ToolTip="最小化到任务栏（点击任务栏图标恢复）" AutomationProperties.Name="最小化便签" Click="Minimize_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="20,16,15,0">
        <TextBlock x:Name="Placeholder" Text="记点什么吧…" FontSize="16" Foreground="#A79B71" IsHitTestVisible="False" Margin="0,3,0,0"/>
        <TextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="0,3,2,8"
                 FontFamily="Segoe UI Symbol, Microsoft YaHei UI"
                 FontSize="16" Foreground="#423D2C" CaretBrush="#423D2C" SelectionBrush="#D2BD73"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                 TextChanged="Editor_TextChanged" AutomationProperties.Name="便签内容"/>
        <Canvas x:Name="CompletionLayer" ClipToBounds="True" IsHitTestVisible="False"/>
        <Canvas x:Name="CheckboxLayer" ClipToBounds="True"/>
      </Grid>
      <Grid Grid.Row="2" Margin="20,0,15,0">
        <TextBlock x:Name="SaveStatus" Text="已保存到本机" FontSize="10" Foreground="#968A62" VerticalAlignment="Center"/>
        <TextBlock Text="◢" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,4" FontSize="12" Foreground="#B6A56B" IsHitTestVisible="False"/>
      </Grid>
    </Grid>
  </Border>
</Window>
